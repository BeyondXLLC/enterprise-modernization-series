BT 1 0 0 1 0 108.2 Tm /F3 6.6 Tf 8.2 TL (-- Inventory Oracle temporal columns) Tj T* (SELECT owner, table_name, column_name, data_type,) Tj T* (       data_length, data_precision, data_scale) Tj T* (FROM dba_tab_columns) Tj T* (WHERE owner='OWNER') Tj T* (  AND data_type IN \('DATE','TIMESTAMP','TIMESTAMP WITH TIME ZONE',) Tj T* (                    'TIMESTAMP WITH LOCAL TIME ZONE'\)) Tj T* (ORDER BY table_name, column_id;) Tj T*  T* (-- Determine whether an Oracle DATE actually contains time-of-day values) Tj T* (SELECT COUNT\(*\) AS total_rows,) Tj T* (       SUM\(CASE WHEN date_column <> TRUNC\(date_column\) THEN 1 ELSE 0 END\)) Tj T* (         AS rows_with_time) Tj T* (FROM owner.table_name;) Tj T* ET
